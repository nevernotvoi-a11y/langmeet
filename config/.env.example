# Строка подключения к PostgreSQL (по одной базе на домен)
DATABASE_URL=postgresql://user:password@localhost:5432/langmeet
# Redis: кэш и очередь заявок Matching Service
REDIS_URL=redis://localhost:6379/0
# Секрет для подписи JWT
JWT_SECRET=replace_me
# Ключ внешнего платёжного шлюза
PAYMENT_GATEWAY_KEY=replace_me